# Kernel options for the analysis IR build (extractor/build_kernel_ir.sh).
# Merged on top of `defconfig` and tools/testing/selftests/sched_ext/config.
# Keep these in line with Epic D's test VM (validation/vm/config) so the call
# graph describes the same kernel the tests run on.

# DEBUG_INFO is not user-selectable on its own; pick a DWARF variant.
# The extractor recovers struct.field names and source lines from DWARF.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_NUMA=y
CONFIG_HOTPLUG_CPU=y
# lockdep: keeps lockdep_assert_*() calls in the IR (assert_held events).
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_KALLSYMS_ALL=y
# Core scheduling exposes ops.core_sched_before (scx_prio_less).
CONFIG_SCHED_CORE=y
